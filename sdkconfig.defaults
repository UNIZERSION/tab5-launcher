CONFIG_IDF_TARGET="esp32p4"
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
# Tab5 ships with ESP32-P4 silicon below v3.0
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Partition table: launcher (factory) + app0/app1 (ota_0/ota_1) + spiffs + vfs + coredump
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
# The bootloader (0x2000..0x8000) has 24 KB; the override adds a little code
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y
# Apps are switched through otadata by the launcher, never rolled back
# CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE is not set

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# RGB565 rows are not always 4-byte aligned
CONFIG_LIBC_OPTIMIZED_MISALIGNED_ACCESS=y

# M5Stack Tab5 BSP
CONFIG_BSP_ERROR_CHECK=n
CONFIG_BSP_SD_FORMAT_ON_MOUNT_FAIL=n
CONFIG_BSP_SD_MOUNT_POINT="/sdcard"
CONFIG_BSP_LCD_USE_DMA2D=y
CONFIG_BSP_DISPLAY_LVGL_AVOID_TEAR=n
# Landscape without tearing (main/l5_display.c): LVGL renders 1280x720, the PPA rotates each
# piece into a hidden 720x1280 DPI frame buffer, the frame is published once per refresh
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=3
CONFIG_LVGL_PORT_ENABLE_PPA=y
# The DPI DMA is restarted after every frame by the DW_GDMA "trans done" interrupt. Without this
# the interrupt is masked while flash is erased / written (cache off): scan-out stops and the
# panel flickers during SD installs and partition changes. l5_display's VSYNC callback is IRAM-safe.
CONFIG_LCD_DSI_ISR_CACHE_SAFE=y

# LVGL 9
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_USE_DEMO_WIDGETS=n
CONFIG_LV_USE_CANVAS=y
# Two LVGL draw threads render in parallel on both cores. LVGL's FreeRTOS layer uses semaphores
# (not task notifications): esp_lvgl_port also wakes the LVGL task with task notifications.
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_FREERTOS_TASK_NOTIFY=n
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_DRAW_THREAD_STACK_SIZE=16384
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
# The launcher's faces of 24 px and more are stored compressed (tools/gen_fonts.py): 100 KB less flash
CONFIG_LV_USE_FONT_COMPRESSED=y
# Only the widgets the launcher creates (obj, label, button, bar, canvas/image) are built. The default
# theme refers to every enabled widget class, so the unused ones were linked in (73 KB, measured).
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_ARC=n
CONFIG_LV_USE_BUTTONMATRIX=n
CONFIG_LV_USE_CALENDAR=n
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_CHECKBOX=n
CONFIG_LV_USE_DROPDOWN=n
CONFIG_LV_USE_IMAGEBUTTON=n
CONFIG_LV_USE_KEYBOARD=n
CONFIG_LV_USE_LED=n
CONFIG_LV_USE_LINE=n
CONFIG_LV_USE_LIST=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_MSGBOX=n
CONFIG_LV_USE_ROLLER=n
CONFIG_LV_USE_SCALE=n
CONFIG_LV_USE_SLIDER=n
CONFIG_LV_USE_SPAN=n
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_USE_SPINNER=n
CONFIG_LV_USE_SWITCH=n
CONFIG_LV_USE_TEXTAREA=n
CONFIG_LV_USE_TABLE=n
CONFIG_LV_USE_TABVIEW=n
CONFIG_LV_USE_TILEVIEW=n
CONFIG_LV_USE_WIN=n
CONFIG_LV_USE_THEME_SIMPLE=n
CONFIG_LV_USE_OBSERVER=n
# Custom fonts (lv_font_conv) contain U+00B7, U+00D7 and U+2026
CONFIG_LV_TXT_ENC_UTF8=y

# Wi-Fi: the on-board ESP32-C6 runs ESP-Hosted on SDIO slot 1 (this Tab5: slave 2.12.6). Wiring as in
# M5Stack's M5Tab5-UserDemo: CLK 12, CMD 13, D0-D3 11/10/9/8, C6 reset (EN) on GPIO 15, 4-bit bus at
# 40 MHz, streaming RX. The SD card shares the SDMMC controller on slot 0.
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
# EN is active low, which ESP-Hosted 2.x calls "Active High": its reset pulse is high-low-high
# (1.4.x ignored the setting; "Active Low" in 2.x ends with the C6 held in reset)
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=13
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=12
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=11
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=10
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=9
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=8
# A software restart of the launcher boots the app selected in otadata: the launcher handles transport
# failures itself (ESP_HOSTED_EVENT_TRANSPORT_FAILURE) instead of ESP-Hosted restarting the chip
CONFIG_ESP_HOSTED_TRANSPORT_RESTART_ON_FAILURE=n
# not used by the launcher
CONFIG_ESP_HOSTED_CLI_ENABLED=n
CONFIG_ESP_HOSTED_MEM_MONITOR=n
CONFIG_ESP_HOSTED_ENABLE_ITWT=n
# ESP-Hosted posts Wi-Fi events and esp_netif's handlers make RPC calls in the default event loop task
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
# IPv4 only: the launcher lives in a fixed 2 MB partition (README "Wi-Fi", size)
CONFIG_LWIP_IPV6=n

# OTA over HTTPS (main/l5_net.c) in the fixed 2 MB partition: a TLS client with ECDHE key exchange,
# AES-GCM, curves P-256 / P-384 / X25519, and a root CA bundle of only the roots OTA's hosts use
# (certs/ota_roots.pem; the bundle keeps subject + key per root). TLS buffers go to PSRAM, so the
# internal RAM stays for ESP-Hosted.
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_NONE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="certs/ota_roots.pem"
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_RSA=n
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n
CONFIG_MBEDTLS_CCM_C=n
CONFIG_MBEDTLS_PKCS7_C=n
CONFIG_MBEDTLS_CMAC_C=n
CONFIG_MBEDTLS_ECDSA_DETERMINISTIC=n
CONFIG_MBEDTLS_PEM_WRITE_C=n
CONFIG_MBEDTLS_X509_CRL_PARSE_C=n
CONFIG_MBEDTLS_X509_CSR_PARSE_C=n
CONFIG_MBEDTLS_ERROR_STRINGS=n
CONFIG_MBEDTLS_FS_IO=n
CONFIG_MBEDTLS_GCM_SUPPORT_NON_AES_CIPHER=n
CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n

# FAT32 / exFAT on the SD card: long names for .bin files (exFAT itself: cmake/exfat.cmake)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
# ff.c with FF_FS_EXFAT = 1 uses FF_USE_LABEL in C code, so the option must be defined
CONFIG_FATFS_USE_LABEL=y
